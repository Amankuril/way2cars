# ─────────────────────────────────────────────────────────────────────────────
# WAY2CARS backend configuration. Copy to .env and fill in. Never commit .env.
# The server validates this file at startup and refuses to boot in production
# when required values are missing.
# ─────────────────────────────────────────────────────────────────────────────

# development | test | staging | production
NODE_ENV=development
PORT=4000
# Bind address. Keep 127.0.0.1 behind Nginx; use 0.0.0.0 to reach the API from a phone on your LAN in dev.
HOST=127.0.0.1
# Express "trust proxy" (number of hops or a preset such as loopback) — needed for real client IPs behind Nginx.
TRUST_PROXY=loopback
# Public base URL of the web front (admin panel origin). Used in email/push deep links.
APP_PUBLIC_URL=http://localhost:5173
# Comma-separated browser origins allowed to call the API (admin panel). Native apps don't send Origin.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# MongoDB — MUST be a replica set (transactions are required for race-safe bookings and payments).
MONGODB_URI=mongodb://127.0.0.1:27017/way2cars?replicaSet=rs0

# ── Secrets (generate with: openssl rand -base64 48) ─────────────────────────
JWT_ACCESS_SECRET=
OTP_HMAC_SECRET=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts bank account numbers, licence/PAN numbers, MFA seeds.
# Changing it makes existing encrypted values unreadable — rotate with a migration.
DATA_ENCRYPTION_KEY=
JWT_ACCESS_TTL_SECONDS=900
USER_REFRESH_TTL_DAYS=30
ADMIN_REFRESH_TTL_HOURS=12
# Cookies are only used by the admin web panel. Must be true in production (HTTPS).
COOKIE_SECURE=true

# ── OTP ──────────────────────────────────────────────────────────────────────
# true  → every number accepts the static OTP 123456 (NEVER in production).
# false → real OTP via SMS India Hub, except numbers listed in OTP_DUMMY_NUMBERS.
OTP_BYPASS_ENABLED=false
# Comma-separated numbers that ALWAYS accept 123456 in every environment (store/QA review accounts).
OTP_DUMMY_NUMBERS=
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_PER_PHONE_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=30

# ── Admin authentication ─────────────────────────────────────────────────────
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCKOUT_MINUTES=15
# true → admins must enrol TOTP MFA on first sign-in.
ADMIN_REQUIRE_MFA=false

# ── SMS India Hub (transactional REST API) ───────────────────────────────────
SMS_ENABLED=false
SMSINDIAHUB_API_URL=https://cloud.smsindiahub.in/api/mt/SendSMS
SMSINDIAHUB_DELIVERY_URL=https://cloud.smsindiahub.in/api/mt/GetDelivery
SMSINDIAHUB_API_KEY=
# 6-character DLT-approved sender ID
SMSINDIAHUB_SENDER_ID=
SMSINDIAHUB_ROUTE=1
SMSINDIAHUB_CHANNEL=2
# DLT principal entity ID
SMSINDIAHUB_PEID=
SMSINDIAHUB_TIMEOUT_MS=8000
# DLT template IDs. The message text in backend/src/integrations/sms.js must match the registered templates exactly.
SMS_TEMPLATE_OTP=
SMS_TEMPLATE_BOOKING_CONFIRMED=
SMS_TEMPLATE_PAYMENT=
SMS_TEMPLATE_REMINDER=
SMS_TEMPLATE_VENDOR_BOOKING=
SMS_TEMPLATE_GENERIC=

# ── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks: URL https://<api-host>/api/v1/webhooks/razorpay, events payment.captured,
# payment.failed, order.paid, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=

# ── Google Maps Platform ─────────────────────────────────────────────────────
# Server key (restrict by server IP; enable Places API (New), Geocoding API, Routes API).
GOOGLE_MAPS_SERVER_KEY=
# Android key for map tiles in the apps is supplied at APK build time (apps/*/android/local.properties), not here.
GOOGLE_MAPS_BROWSER_KEY=
MAPS_CACHE_TTL_SECONDS=86400

# ── Firebase Cloud Messaging (server) ────────────────────────────────────────
# Either a path to the service-account JSON (outside the repo) or its base64 contents.
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_WEB_CONFIG_JSON=
FIREBASE_WEB_VAPID_KEY=

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=WAY2CARS <no-reply@way2cars.in>

# ── File storage ─────────────────────────────────────────────────────────────
# Public media (vehicle photos, banners) — served by Nginx at /uploads/.
# Production: /var/www/<project>/uploads
PUBLIC_UPLOAD_DIR=./storage/public
# Private documents (KYC, RC, insurance, inspection photos) — OUTSIDE any web root.
# Production example: /var/lib/way2cars/private
PRIVATE_UPLOAD_DIR=./storage/private
PUBLIC_MEDIA_BASE_URL=http://localhost:4000/uploads
# Dev convenience: let Express serve /uploads (ignored in production — Nginx does it).
SERVE_PUBLIC_UPLOADS=true
# stream = Node streams private files; x-accel = Nginx serves them via an internal location after Node authorises.
PRIVATE_FILE_DELIVERY=stream
PRIVATE_X_ACCEL_PREFIX=/_protected
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_DOCUMENT_MB=10
UPLOAD_MAX_INPUT_PIXELS=40000000
IMAGE_MAX_DIMENSION=2000
IMAGE_WEBP_QUALITY=80

# ── Rate limits (per instance; OTP/admin lockouts are enforced in MongoDB) ───
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20

# ── Background jobs & tracking ───────────────────────────────────────────────
JOBS_ENABLED=true
# none | generic-webhook (requires a GPS/telematics provider posting signed positions)
TRACKING_PROVIDER=none
TRACKING_WEBHOOK_SECRET=
