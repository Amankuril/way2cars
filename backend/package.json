{
  "name": "@way2cars/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "dev:memory-db": "node --env-file-if-exists=.env scripts/dev-memory-db.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.js",
    "db:indexes": "node --env-file-if-exists=.env scripts/sync-indexes.js",
    "db:seed-catalog": "node --env-file-if-exists=.env scripts/seed-catalog.js",
    "lint": "node scripts/check-syntax.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "file-type": "^21.3.4",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.5.3",
    "mongoose": "^8.24.5",
    "multer": "^2.4.0",
    "nodemailer": "^7.0.13",
    "otpauth": "^9.5.2",
    "pdfkit": "^0.17.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "sharp": "^0.34.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "vitest": "^3.2.7"
  }
}
