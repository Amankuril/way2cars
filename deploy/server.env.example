# WAY2CARS API — server .env for the IP-only setup (http://187.127.170.123).
# Copy to backend/.env on the server and fill every <…>. Never commit the real file.
# Full list of options with explanations: backend/.env.example

NODE_ENV=staging            # production-grade checks; switch to "production" once you have a domain + HTTPS
PORT=5000
HOST=0.0.0.0                # the APKs call http://187.127.170.123:5000 directly
TRUST_PROXY=loopback

# Admin panel origin (served by Nginx on port 80) — the API rejects admin requests from other origins
APP_PUBLIC_URL=http://187.127.170.123
CORS_ORIGINS=http://187.127.170.123

# MongoDB must be a replica set (bookings/payments use transactions). MongoDB Atlas works out of the box.
MONGODB_URI=<mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/way2cars?retryWrites=true&w=majority>

# Generate each with the command shown, on the server. Keep DATA_ENCRYPTION_KEY forever:
# losing it makes stored bank account numbers and admin MFA secrets unreadable.
JWT_ACCESS_SECRET=<openssl rand -base64 48>
OTP_HMAC_SECRET=<openssl rand -base64 48>
DATA_ENCRYPTION_KEY=<openssl rand -base64 32>
COOKIE_SECURE=true

# OTP. Until SMSIndiaHub is set up, OTP_BYPASS_ENABLED=true makes EVERY number accept 123456 — testing only.
OTP_BYPASS_ENABLED=true
OTP_DUMMY_NUMBERS=
SMS_ENABLED=false
SMSINDIAHUB_API_KEY=
SMSINDIAHUB_SENDER_ID=
SMSINDIAHUB_PEID=
SMS_TEMPLATE_OTP=

# Required in staging/production. Test keys (rzp_test_…) are fine for now.
RAZORPAY_KEY_ID=<rzp_test_…>
RAZORPAY_KEY_SECRET=<…>
RAZORPAY_WEBHOOK_SECRET=<…>

# Uploads (absolute paths outside the git checkout so deploys never touch them)
PUBLIC_UPLOAD_DIR=/var/lib/way2cars/public
PRIVATE_UPLOAD_DIR=/var/lib/way2cars/private
PUBLIC_MEDIA_BASE_URL=http://187.127.170.123:5000/uploads
SERVE_PUBLIC_UPLOADS=true

JOBS_ENABLED=true
LOG_LEVEL=info

# Optional integrations — leave empty until you have keys
GOOGLE_MAPS_SERVER_KEY=
FIREBASE_SERVICE_ACCOUNT_BASE64=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
